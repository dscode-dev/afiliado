# ---------------------------------------------------------------------------
# Afiliado - variaveis de ambiente (PR-01)
# Copie para `.env` na raiz e ajuste conforme o ambiente.
# ---------------------------------------------------------------------------

# Ambiente logico da aplicacao: development | test | production
APP_ENV=development

# Porta HTTP da API NestJS
API_PORT=3333

# Conexao PostgreSQL usada pelo Prisma (API + migrations)
DATABASE_URL=postgresql://afiliado:afiliado@localhost:5432/afiliado?schema=public

# Conexao usada pela suite de testes de integracao (banco separado)
TEST_DATABASE_URL=postgresql://afiliado:afiliado@localhost:5432/afiliado_test?schema=public

# Origens permitidas no CORS da API. Lista separada por virgula, ou `*`.
CORS_ORIGINS=http://localhost:3000

# Nivel minimo de log: debug | log | warn | error
LOG_LEVEL=log

# Porta exposta pelo container do PostgreSQL (docker compose)
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Admin (Next.js)
# ---------------------------------------------------------------------------

# URL base da API interna consumida pelo painel administrativo
API_BASE_URL=http://localhost:3333

# ---------------------------------------------------------------------------
# Integracao Mercado Livre (PR-02)
#
# Crie uma aplicacao em https://developers.mercadolivre.com.br/devcenter e use
# as credenciais dela aqui. Sem estas variaveis a API sobe normalmente, mas os
# endpoints de import/sync/highlights respondem 502.
#
# NUNCA comite valores reais: este arquivo e apenas o modelo.
# ---------------------------------------------------------------------------

# Client ID da aplicacao no DevCenter do Mercado Livre
MELI_CLIENT_ID=

# Client Secret da aplicacao. Secret: apenas em .env, nunca versionado.
MELI_CLIENT_SECRET=

# Redirect URI registrada na aplicacao. Usada apenas para obter o refresh token
# pelo fluxo authorization_code (ver README).
MELI_REDIRECT_URI=http://localhost:3333/marketplace/mercado-livre/callback

# Site do Mercado Livre. Esta versao suporta somente MLB (Brasil).
MELI_SITE_ID=MLB

# Opcional. Preenchido apenas se a aplicacao precisar de contexto de usuario.
# Sem ele, a integracao usa o grant client_credentials.
MELI_REFRESH_TOKEN=

# Timeout (ms) de cada chamada ao Mercado Livre
MELI_TIMEOUT_MS=10000

# Concorrencia do sync em lote (1 a 8)
MELI_SYNC_CONCURRENCY=4

# Base da API oficial. Sobrescrito apenas nos testes automatizados.
MELI_API_BASE_URL=https://api.mercadolibre.com

# ---------------------------------------------------------------------------
# Opportunity Engine (PR-03)
#
# Os pesos dos cinco componentes sao constantes versionadas em codigo
# (apps/api/src/modules/opportunity/scoring/weights.ts): sao regra de negocio,
# revisada em code review. Apenas os limiares de decisao e o cooldown, que
# variam por operacao, vem daqui.
# ---------------------------------------------------------------------------

# Score minimo para o engine recomendar APPROVED (0-100)
OPPORTUNITY_APPROVED_THRESHOLD=85

# Score minimo para o engine recomendar CANDIDATE (0-100)
OPPORTUNITY_CANDIDATE_THRESHOLD=70

# Horas em que a mesma oportunidade (produto + preco) ja aprovada nao e
# reprocessada
OPPORTUNITY_COOLDOWN_HOURS=24

# Janela do historico de precos considerada na avaliacao (dias)
OPPORTUNITY_HISTORY_WINDOW_DAYS=30

# ---------------------------------------------------------------------------
# Telegram (PR-04)
#
# Crie o bot no @BotFather, adicione-o como ADMINISTRADOR do canal publico e
# conceda a permissao "Post Messages". Ver README.
#
# O token e um SECRET: fica so aqui, nunca no banco, em log ou no frontend.
# NUNCA comite um valor real neste arquivo.
# ---------------------------------------------------------------------------

# Token do bot fornecido pelo @BotFather (formato 123456789:AA...)
TELEGRAM_BOT_TOKEN=

# Timeout (ms) de cada chamada a Bot API
TELEGRAM_TIMEOUT_MS=15000

# Teto para respeitar o `retry_after` de respostas 429; acima disso, falha
TELEGRAM_MAX_RETRY_AFTER_SECONDS=5

# Base da Bot API oficial. Sobrescrita apenas nos testes automatizados.
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ---------------------------------------------------------------------------
# Autopilot / Automation Loop (PR-05)
#
# PREMISSA: instancia unica. A trava contra ciclos simultaneos e em memoria;
# multiplas replicas exigiriam coordenacao distribuida (fora de escopo).
# ---------------------------------------------------------------------------

# Liga os jobs agendados. O ciclo manual (POST /automation/run) funciona mesmo
# com isto em false.
AUTOMATION_SCHEDULER_ENABLED=true

# Intervalos de cada job, em minutos
PRODUCT_REFRESH_INTERVAL_MINUTES=60
OPPORTUNITY_EVALUATION_INTERVAL_MINUTES=30
TELEGRAM_DISTRIBUTION_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# Politica de publicacao automatica
#
# ATENCAO: o autopilot e OPT-IN. Com false o ciclo continua sincronizando e
# avaliando, mas NADA e publicado. Ligue apenas quando o canal estiver pronto.
# ---------------------------------------------------------------------------
TELEGRAM_AUTO_PUBLISH_ENABLED=false

# Limites por canal, contando apenas publicacoes bem-sucedidas
TELEGRAM_MAX_POSTS_PER_HOUR=2
TELEGRAM_MAX_POSTS_PER_DAY=12

# Score minimo do Opportunity Engine para publicacao automatica
TELEGRAM_MIN_SCORE=85

# Ofertas detectadas ha mais tempo que isto nao sao publicadas automaticamente
TELEGRAM_MAX_OFFER_AGE_HOURS=24

# Janela de publicacao [start, end) na timezone abaixo. Iguais = sem restricao.
TELEGRAM_PUBLISH_START_HOUR=7
TELEGRAM_PUBLISH_END_HOUR=22

# Timezone usada na janela de publicacao
APP_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Facebook / Meta Graph API (PR-06)
#
# Crie a app em developers.facebook.com, adicione o produto "Facebook Login",
# conceda ao token as permissoes pages_manage_posts, pages_read_engagement e
# pages_show_list, e gere um PAGE ACCESS TOKEN (nao um user token). Ver README.
#
# O token e um SECRET: fica so aqui, nunca no banco, em log ou no frontend.
# NUNCA comite um valor real neste arquivo.
# ---------------------------------------------------------------------------

META_APP_ID=
META_APP_SECRET=

# Page Access Token com permissao de publicar na Page
META_PAGE_ACCESS_TOKEN=

# Versao da Graph API usada nas chamadas
META_API_VERSION=v21.0

# Timeout (ms) de cada chamada a Graph API
META_TIMEOUT_MS=15000

# Base da Graph API. Sobrescrita apenas nos testes automatizados.
META_API_BASE_URL=https://graph.facebook.com

# ---------------------------------------------------------------------------
# Autopilot do Facebook
#
# Independente do Telegram: cada destino e opt-in separado.
# ---------------------------------------------------------------------------
FACEBOOK_AUTO_PUBLISH_ENABLED=false
FACEBOOK_MAX_POSTS_PER_HOUR=1
FACEBOOK_MAX_POSTS_PER_DAY=6
FACEBOOK_MIN_SCORE=85
