// Afiliado - schema de dominio do PR-01 (fundacao).
// Escopo: catalogo, links de afiliado, canais, ofertas e publicacoes.
// Integracoes externas (Mercado Livre, Telegram, Meta) nao fazem parte deste PR.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Marketplace {
  MERCADO_LIVRE
}

/// Como o link de afiliado foi obtido.
enum AffiliateLinkSource {
  /// Cadastrado a mao pelo operador.
  MANUAL
  /// Gerado pelo affiliate-bot na Central de Afiliados (adapter NAO oficial).
  MERCADO_LIVRE_AFFILIATE_WEB
}

enum ChannelType {
  TELEGRAM
  FACEBOOK
  WHATSAPP
}

enum OfferStatus {
  DETECTED
  CANDIDATE
  APPROVED
  REJECTED
  EXPIRED
}

/// Recomendacao do Opportunity Engine para um produto.
enum OpportunityStatus {
  IGNORE
  CANDIDATE
  APPROVED
  NOT_ELIGIBLE
}

/// Decisao humana explicita, que sobrepoe a recomendacao do engine.
enum OperatorDecision {
  APPROVED
  REJECTED
}

enum PublicationStatus {
  PENDING
  PUBLISHED
  FAILED
  CANCELLED
}

/// Produto monitorado em um marketplace.
///
/// Modelo operacional normalizado: guardamos apenas os campos que a aplicacao
/// usa, nunca o payload bruto do marketplace.
model Product {
  id                String      @id @default(uuid()) @db.Uuid
  marketplace       Marketplace
  marketplaceItemId String      @db.VarChar(64)
  title             String      @db.VarChar(300)
  category          String?     @db.VarChar(120)
  imageUrl          String?     @db.VarChar(2048)
  currentPrice      Decimal     @db.Decimal(12, 2)
  originalPrice     Decimal?    @db.Decimal(12, 2)
  /// Flag de monitoramento nossa - controlada pelo operador, nao pelo marketplace.
  active            Boolean     @default(true)
  permalink         String?     @db.VarChar(2048)
  sellerId          String?     @db.VarChar(32)
  categoryId        String?     @db.VarChar(32)
  currencyId        String?     @db.VarChar(8)
  /// Status do anuncio no marketplace (active | paused | closed | ...).
  marketplaceStatus String?     @db.VarChar(32)
  /// Posicao nos mais vendidos da categoria; null = ausente do ranking.
  highlightPosition Int?
  /// Quando a popularidade foi verificada pela ultima vez (null = nunca).
  highlightCheckedAt DateTime?  @db.Timestamptz(3)
  /// Reputacao do vendedor (ex.: "5_green"), coletada na sincronizacao.
  sellerReputationLevel String? @db.VarChar(32)
  /// Status de power seller (ex.: "platinum"), quando o vendedor possui.
  sellerStatus      String?     @db.VarChar(32)
  lastSyncedAt      DateTime?   @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  affiliateLinks AffiliateLink[]
  offers         Offer[]
  priceSnapshots PriceSnapshot[]
  evaluation     OpportunityEvaluation?

  @@unique([marketplace, marketplaceItemId])
  @@index([active, createdAt(sort: Desc)])
  @@index([active, lastSyncedAt])
  @@map("products")
}

/// Registro historico e imutavel do preco de um produto em um instante.
///
/// So e gravado quando o preco muda (ver ProductSyncService), para que o
/// historico registre mudancas de preco e nao telemetria de alta frequencia.
model PriceSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  price         Decimal  @db.Decimal(12, 2)
  originalPrice Decimal? @db.Decimal(12, 2)
  currencyId    String?  @db.VarChar(8)
  capturedAt    DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt(sort: Desc)])
  @@map("price_snapshots")
}

/// Link de afiliado cadastrado manualmente para um produto.
model AffiliateLink {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String   @db.VarChar(2048)
  label     String?  @db.VarChar(120)
  /// De onde o link veio (ex.: "painel-afiliados", "campanha-x").
  sourceLabel String? @db.VarChar(120)
  /// Canal a que o link se destina, quando houver segmentacao por canal.
  channelTag  String? @db.VarChar(120)
  /// Origem do link. Publicacao automatica exige link realmente monetizado.
  source      AffiliateLinkSource @default(MANUAL)
  /// Tag de afiliado usada na geracao, quando gerado automaticamente.
  tag         String? @db.VarChar(120)
  /// URL de origem que o provider associou ao link (permalink do produto).
  originUrl   String? @db.VarChar(2048)
  generatedAt DateTime? @db.Timestamptz(3)
  /// Ultima vez que o link foi conferido contra o provider.
  verifiedAt  DateTime? @db.Timestamptz(3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, active])
  @@index([source, active])
  @@map("affiliate_links")
}

/// Destino de publicacao de ofertas.
model Channel {
  id                 String      @id @default(uuid()) @db.Uuid
  type               ChannelType
  name               String      @db.VarChar(120)
  externalIdentifier String?     @db.VarChar(255)
  active             Boolean     @default(true)
  /// Apenas dados nao sensiveis. Secrets vivem em environment variables.
  configuration      Json        @default("{}")
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  publications Publication[]

  @@unique([type, name])
  @@index([active])
  @@map("channels")
}

/// Oportunidade detectada sobre um produto.
model Offer {
  id                 String      @id @default(uuid()) @db.Uuid
  productId          String      @db.Uuid
  price              Decimal     @db.Decimal(12, 2)
  originalPrice      Decimal?    @db.Decimal(12, 2)
  discountPercentage Decimal?    @db.Decimal(5, 2)
  status             OfferStatus @default(DETECTED)
  detectedAt         DateTime    @default(now()) @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  publications Publication[]

  /// Identidade da oportunidade: um produto a um determinado preco.
  /// Garante no banco a idempotencia da geracao automatica de ofertas.
  @@unique([productId, price])
  @@index([status, detectedAt(sort: Desc)])
  @@index([productId])
  @@map("offers")
}

/// Tentativa de publicacao de uma oferta em um canal.
model Publication {
  id                String            @id @default(uuid()) @db.Uuid
  offerId           String            @db.Uuid
  channelId         String            @db.Uuid
  status            PublicationStatus @default(PENDING)
  externalMessageId String?           @db.VarChar(255)
  scheduledAt       DateTime?         @db.Timestamptz(3)
  publishedAt       DateTime?         @db.Timestamptz(3)
  errorMessage      String?           @db.VarChar(1000)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Restrict)

  /// Uma oferta e publicada no maximo uma vez por canal. A garantia vive no
  /// banco: e ela que impede publicacao duplicada sob chamadas concorrentes.
  @@unique([offerId, channelId])
  @@index([status, createdAt(sort: Desc)])
  @@index([offerId])
  @@index([channelId])
  @@map("publications")
}

/// Ultima avaliacao do Opportunity Engine para um produto.
///
/// Uma linha por produto (upsert), e nao um historico: o fluxo operacional so
/// precisa do estado atual, e Offer ja registra as oportunidades geradas.
/// Guardar historico de avaliacao seria complexidade sem caso de uso hoje.
model OpportunityEvaluation {
  id          String            @id @default(uuid()) @db.Uuid
  productId   String            @unique @db.Uuid
  score       Int
  /// Recomendacao do engine, sempre derivada do score e da elegibilidade.
  status      OpportunityStatus
  /// Componentes do score (earned/max por componente), para explicabilidade.
  breakdown   Json
  /// Frases legiveis que justificam o score ao operador.
  reasons     String[]
  evaluatedAt DateTime          @default(now()) @db.Timestamptz(3)

  /// Decisao humana. Preservada entre reavaliacoes - o engine nunca a apaga.
  operatorDecision   OperatorDecision?
  operatorDecidedAt  DateTime?         @db.Timestamptz(3)
  operatorNote       String?           @db.VarChar(300)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status, score(sort: Desc)])
  @@map("opportunity_evaluations")
}

/// Operador do painel. Nao ha cadastro publico: o primeiro admin e criado
/// pelo comando `npm run admin:create`.
model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  /// Hash argon2id. A senha em texto puro nunca e persistida nem logada.
  passwordHash String    @db.VarChar(255)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  sessions AdminSession[]

  @@map("admin_users")
}

/// Sessao administrativa.
///
/// O cookie carrega um token opaco de 32 bytes (CSPRNG); aqui guardamos apenas
/// o SHA-256 dele. Vazamento do banco nao permite reconstruir o token.
/// SHA-256 e adequado neste caso - o token e aleatorio de alta entropia, nao
/// uma senha, entao nao precisa de KDF lento.
model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  lastSeenAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  user AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([adminUserId])
  @@map("admin_sessions")
}

/// Credencial OAuth de um marketplace.
///
/// Existe porque o Mercado Livre exige Authorization Code para itens, precos,
/// highlights e vendedores - `client_credentials` so alcanca categorias. O
/// refresh token e rotativo, entao precisa ser persistido; fica cifrado com
/// AES-256-GCM (chave em `MELI_TOKEN_SECRET`), nunca em texto puro.
model MarketplaceCredential {
  id             String      @id @default(uuid()) @db.Uuid
  marketplace    Marketplace @unique
  /// Refresh token cifrado. Nunca logado, nunca devolvido pela API.
  refreshTokenEnc String     @db.Text
  /// Id do usuario do marketplace que autorizou, para diagnostico.
  externalUserId String?     @db.VarChar(64)
  scope          String?     @db.VarChar(255)
  authorizedAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  @@map("marketplace_credentials")
}
