// Afiliado - schema de dominio do PR-01 (fundacao).
// Escopo: catalogo, links de afiliado, canais, ofertas e publicacoes.
// Integracoes externas (Mercado Livre, Telegram, Meta) nao fazem parte deste PR.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Marketplace {
  MERCADO_LIVRE
}

enum ChannelType {
  TELEGRAM
  FACEBOOK
  WHATSAPP
}

enum OfferStatus {
  DETECTED
  CANDIDATE
  APPROVED
  REJECTED
  EXPIRED
}

enum PublicationStatus {
  PENDING
  PUBLISHED
  FAILED
  CANCELLED
}

/// Produto monitorado em um marketplace.
///
/// Modelo operacional normalizado: guardamos apenas os campos que a aplicacao
/// usa, nunca o payload bruto do marketplace.
model Product {
  id                String      @id @default(uuid()) @db.Uuid
  marketplace       Marketplace
  marketplaceItemId String      @db.VarChar(64)
  title             String      @db.VarChar(300)
  category          String?     @db.VarChar(120)
  imageUrl          String?     @db.VarChar(2048)
  currentPrice      Decimal     @db.Decimal(12, 2)
  originalPrice     Decimal?    @db.Decimal(12, 2)
  /// Flag de monitoramento nossa - controlada pelo operador, nao pelo marketplace.
  active            Boolean     @default(true)
  permalink         String?     @db.VarChar(2048)
  sellerId          String?     @db.VarChar(32)
  categoryId        String?     @db.VarChar(32)
  currencyId        String?     @db.VarChar(8)
  /// Status do anuncio no marketplace (active | paused | closed | ...).
  marketplaceStatus String?     @db.VarChar(32)
  lastSyncedAt      DateTime?   @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  affiliateLinks AffiliateLink[]
  offers         Offer[]
  priceSnapshots PriceSnapshot[]

  @@unique([marketplace, marketplaceItemId])
  @@index([active, createdAt(sort: Desc)])
  @@index([active, lastSyncedAt])
  @@map("products")
}

/// Registro historico e imutavel do preco de um produto em um instante.
///
/// So e gravado quando o preco muda (ver ProductSyncService), para que o
/// historico registre mudancas de preco e nao telemetria de alta frequencia.
model PriceSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  price         Decimal  @db.Decimal(12, 2)
  originalPrice Decimal? @db.Decimal(12, 2)
  currencyId    String?  @db.VarChar(8)
  capturedAt    DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt(sort: Desc)])
  @@map("price_snapshots")
}

/// Link de afiliado cadastrado manualmente para um produto.
model AffiliateLink {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  url       String   @db.VarChar(2048)
  label     String?  @db.VarChar(120)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, active])
  @@map("affiliate_links")
}

/// Destino de publicacao de ofertas.
model Channel {
  id                 String      @id @default(uuid()) @db.Uuid
  type               ChannelType
  name               String      @db.VarChar(120)
  externalIdentifier String?     @db.VarChar(255)
  active             Boolean     @default(true)
  /// Apenas dados nao sensiveis. Secrets vivem em environment variables.
  configuration      Json        @default("{}")
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  publications Publication[]

  @@unique([type, name])
  @@index([active])
  @@map("channels")
}

/// Oportunidade detectada sobre um produto.
model Offer {
  id                 String      @id @default(uuid()) @db.Uuid
  productId          String      @db.Uuid
  price              Decimal     @db.Decimal(12, 2)
  originalPrice      Decimal?    @db.Decimal(12, 2)
  discountPercentage Decimal?    @db.Decimal(5, 2)
  status             OfferStatus @default(DETECTED)
  detectedAt         DateTime    @default(now()) @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @db.Timestamptz(3)

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  publications Publication[]

  @@index([status, detectedAt(sort: Desc)])
  @@index([productId])
  @@map("offers")
}

/// Tentativa de publicacao de uma oferta em um canal.
model Publication {
  id                String            @id @default(uuid()) @db.Uuid
  offerId           String            @db.Uuid
  channelId         String            @db.Uuid
  status            PublicationStatus @default(PENDING)
  externalMessageId String?           @db.VarChar(255)
  scheduledAt       DateTime?         @db.Timestamptz(3)
  publishedAt       DateTime?         @db.Timestamptz(3)
  errorMessage      String?           @db.VarChar(1000)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Restrict)

  @@index([status, createdAt(sort: Desc)])
  @@index([offerId])
  @@index([channelId])
  @@map("publications")
}
